# Copy this file to `.env` (docker compose loads it automatically) and fill in real
# values before running anywhere reachable beyond your own machine. The defaults baked
# into docker-compose.yml (tradepass / devtoken-change-me / admin) are for local dev
# only — every port in docker-compose.yml is bound to 127.0.0.1, but a weak password is
# still a weak password once something *does* proxy a port through, and NATS_TOKEN is
# the only thing standing between "compose file" and "anyone who can reach 4222 can
# toggle the kill switch".

# Postgres password for the `trade` user/database.
POSTGRES_PASSWORD=change-me-to-a-long-random-value

# NATS auth token — required by both the `nats` service (--auth flag) and trade-service
# (NATS_TOKEN env var) to connect. Must match on both sides.
NATS_TOKEN=change-me-to-a-long-random-value

# Grafana admin password (GF_SECURITY_ADMIN_USER stays "admin").
GRAFANA_ADMIN_PASSWORD=change-me-to-a-long-random-value
